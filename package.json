{
  "name": "agent-push-kit-mcp",
  "version": "0.1.1",
  "description": "Complete Agent Push Kit MCP server over stdio",
  "license": "MIT",
  "author": "Justin Strong",
  "homepage": "https://agentpushkit.com/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustinBStrong/agent-push-kit-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/JustinBStrong/agent-push-kit-mcp/issues"
  },
  "type": "module",
  "mcpName": "io.github.JustinBStrong/agent-push-kit",
  "bin": {
    "agent-push-kit-mcp": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "sync": "node scripts/sync-contract.mjs",
    "prebuild": "npm run sync",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.18.0",
    "typescript": "5.9.2"
  }
}
